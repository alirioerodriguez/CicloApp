{
  "expo": {
    "name": "Savia",
    "slug": "ciclo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ciclo",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF5F2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alirio.ciclo",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Para proteger tus datos con Face ID."
      }
    },
    "android": {
      "package": "com.alirio.ciclo",
      "adaptiveIcon": {
        "backgroundColor": "#FBF5F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_BASAL_BODY_TEMPERATURE",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Savia",
      "shortName": "Savia",
      "themeColor": "#7E2F52",
      "backgroundColor": "#FBF5F2",
      "lang": "es",
      "description": "Savia · la vida que eres y la vida que das. Tu ciclo, tu embarazo, tu posparto y tu menopausia."
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#7E2F52"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Para proteger tus datos con Face ID."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#7E2F52"
        }
      ],
      "expo-localization",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PeriodoCuenta",
              "label": "Savia · Tu próximo período",
              "description": "Cuántos días faltan para tu período",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "CicloHoy",
              "label": "Savia · Tu ciclo hoy",
              "description": "Día del ciclo, fase, próximo período y días fértiles",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PastillaChico",
              "label": "Savia · Pastilla",
              "description": "Pastilla de hoy con botón para marcarla",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PastillaSemana",
              "label": "Savia · Semana del blíster",
              "description": "La semana actual de tu blíster",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ParejaHoy",
              "label": "Savia · Tu pareja hoy",
              "description": "En qué etapa está tu pareja y qué puedes hacer hoy",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Savia lee tus pasos, pulso, sueño y temperatura de Apple Salud para mostrarte cómo cambian en tu ciclo y sumarlos a tu resumen para la médica.",
          "NSHealthUpdateUsageDescription": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
