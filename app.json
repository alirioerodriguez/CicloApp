{
  "expo": {
    "name": "Savia",
    "slug": "ciclo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ciclo",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF5F2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alirio.ciclo",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Para proteger tus datos con Face ID."
      }
    },
    "android": {
      "package": "com.alirio.ciclo",
      "adaptiveIcon": {
        "backgroundColor": "#FBF5F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Savia",
      "shortName": "Savia",
      "themeColor": "#7E2F52",
      "backgroundColor": "#FBF5F2",
      "lang": "es",
      "description": "Savia · la vida que eres y la vida que das. Tu ciclo, tu embarazo, tu posparto y tu menopausia."
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#7E2F52"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Para proteger tus datos con Face ID."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#7E2F52"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
