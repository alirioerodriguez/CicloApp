# Copia este archivo como .env y completa con los datos de tu proyecto de Supabase.
# La clave es la "publishable key" (sb_publishable_...): puede ir en la app; los datos los protege RLS.
# NUNCA pongas aquí la service_role / secret key.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
